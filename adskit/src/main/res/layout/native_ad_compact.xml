<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact native ad. Horizontal: 120dp MediaView (min for video-capable
  mediation) with "Ad" badge + app-icon overlays, and a right column of
  headline · advertiser/rating · CTA. AdChoices is auto-placed by the SDK.
  The card background + text colors + CTA color + font are set at runtime from
  the Compose theme + AdsConfig in NativeAdCard.kt (so it fits any host app).
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/ad_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="11dp">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#14000000" />

            <TextView
                android:id="@+id/ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/ad_badge_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/ad_attribution_label"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="@drawable/ad_icon_bg"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#0F172A"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ad_advertiser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#64748B"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/ad_cta"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
